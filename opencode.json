{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "empero": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Empero Free",
      "options": {
        "baseURL": "https://free.empero.org/v1",
        "apiKey": "free"
      },
      "models": {
        "glm-5.3-flash": {
          "name": "GLM 5.3 Flash",
          "tool_call": true,
          "reasoning": true,
          "attachment": true,
          "temperature": true,
          "limit": { "context": 131072, "output": 65536 }
        },
        "glm-5.3": {
          "name": "GLM 5.3",
          "tool_call": true,
          "reasoning": true,
          "attachment": true,
          "temperature": true,
          "limit": { "context": 131072, "output": 65536 }
        }
      }
    }
  },
  "mcp": {
    "timeout": {
      "startup": 90000
    },
    "playwright": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "@playwright/mcp"],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "@upstash/context7-mcp"],
      "enabled": true
    },
    "website-publisher": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "code-sandbox-mcp@latest"],
      "enabled": true
    },
    "firecrawl": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "firecrawl-mcp"],
      "enabled": true,
      "env": {
        "FIRECRAWL_API_KEY": ""
      }
    }
  }
}
